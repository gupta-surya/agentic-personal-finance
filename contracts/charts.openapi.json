{
  "components": {
    "schemas": {
      "Annotation": {
        "properties": {
          "kind": {
            "enum": [
              "reference_line",
              "reference_dot"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "result_id": {
            "title": "Result Id",
            "type": "string"
          },
          "x": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "X"
          },
          "y": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Y"
          }
        },
        "required": [
          "kind",
          "label",
          "result_id"
        ],
        "title": "Annotation",
        "type": "object"
      },
      "Assumption": {
        "description": "An input behind a number, shown under the chart; a control makes it adjustable.",
        "properties": {
          "control": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SliderControl"
              },
              {
                "type": "null"
              }
            ]
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "source": {
            "enum": [
              "question",
              "you_entered",
              "default",
              "data"
            ],
            "title": "Source",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "value",
          "source"
        ],
        "title": "Assumption",
        "type": "object"
      },
      "ChartSpec": {
        "properties": {
          "annotations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Annotation"
            },
            "title": "Annotations",
            "type": "array"
          },
          "assumptions": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Assumption"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "clarify": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Clarify"
              },
              {
                "type": "null"
              }
            ]
          },
          "params": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Params",
            "type": "object"
          },
          "period": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResolvedPeriod"
              },
              {
                "type": "null"
              }
            ]
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/Series"
            },
            "title": "Series",
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          },
          "table": {
            "$ref": "#/components/schemas/Table"
          },
          "template_id": {
            "title": "Template Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "template_id",
          "title",
          "params",
          "period",
          "series",
          "sources",
          "table"
        ],
        "title": "ChartSpec",
        "type": "object"
      },
      "Clarify": {
        "description": "A question with 2 to 4 options, for when the planner cannot choose confidently.",
        "properties": {
          "options": {
            "items": {
              "$ref": "#/components/schemas/ClarifyOption"
            },
            "title": "Options",
            "type": "array"
          },
          "question": {
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "options"
        ],
        "title": "Clarify",
        "type": "object"
      },
      "ClarifyOption": {
        "description": "A ready request: choosing it sends ``{template_id, params}`` to the render route.",
        "properties": {
          "label": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Params",
            "type": "object"
          },
          "template_id": {
            "title": "Template Id",
            "type": "string"
          }
        },
        "required": [
          "label",
          "template_id",
          "params"
        ],
        "title": "ClarifyOption",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JsonValue": {},
      "PeriodPreset": {
        "enum": [
          "this_month",
          "last_month",
          "last_3_months",
          "last_6_months",
          "last_12_months",
          "year_to_date",
          "last_year",
          "all_time",
          "custom"
        ],
        "title": "PeriodPreset",
        "type": "string"
      },
      "Point": {
        "description": "``x`` is a label or ISO date/month string. Lines and bars set ``y``; ranges set\n``low`` and ``high`` instead.",
        "properties": {
          "high": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "High"
          },
          "low": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Low"
          },
          "x": {
            "title": "X",
            "type": "string"
          },
          "y": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Y"
          }
        },
        "required": [
          "x"
        ],
        "title": "Point",
        "type": "object"
      },
      "RenderRequest": {
        "additionalProperties": false,
        "properties": {
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "template_id": {
            "title": "Template Id",
            "type": "string"
          }
        },
        "required": [
          "template_id"
        ],
        "title": "RenderRequest",
        "type": "object"
      },
      "ResolvedPeriod": {
        "description": "Explicit dates, echoed in the chart spec so the covered range is visible.",
        "properties": {
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "preset": {
            "$ref": "#/components/schemas/PeriodPreset"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "preset",
          "start",
          "end",
          "label"
        ],
        "title": "ResolvedPeriod",
        "type": "object"
      },
      "Series": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "line",
              "bar",
              "area",
              "range",
              "point"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "title": "Points",
            "type": "array"
          },
          "result_id": {
            "title": "Result Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "result_id",
          "points"
        ],
        "title": "Series",
        "type": "object"
      },
      "SliderControl": {
        "properties": {
          "max": {
            "title": "Max",
            "type": "string"
          },
          "min": {
            "title": "Min",
            "type": "string"
          },
          "step": {
            "title": "Step",
            "type": "string"
          },
          "type": {
            "const": "slider",
            "default": "slider",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "min",
          "max",
          "step"
        ],
        "title": "SliderControl",
        "type": "object"
      },
      "Source": {
        "description": "One query or engine result that backs part of the chart.",
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "data_version": {
            "title": "Data Version",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "result_id": {
            "title": "Result Id",
            "type": "string"
          }
        },
        "required": [
          "result_id",
          "query",
          "data_version",
          "as_of"
        ],
        "title": "Source",
        "type": "object"
      },
      "Table": {
        "description": "The same data as the chart, for screen readers and the table toggle.",
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "title": "Columns",
            "type": "array"
          },
          "rows": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "title": "Rows",
            "type": "array"
          }
        },
        "required": [
          "columns",
          "rows"
        ],
        "title": "Table",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Finance Agent charts",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/charts/render": {
      "post": {
        "operationId": "render_chart_charts_render_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChartSpec"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Render Chart"
      }
    }
  }
}
