            "title": "Transacted Date"
          },
          "transfer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TransferInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "posted_date",
          "transacted_date",
          "pending",
          "merchant",
          "description",
          "amount",
          "currency",
          "category",
          "category_source",
          "suggested_category",
          "needs_review",
          "note",
          "hidden",
          "account",
          "transfer"
        ],
        "title": "TransactionRow",
        "type": "object"
      },
      "TransactionTotals": {
        "description": "Same row filter as the catalog (posted, no internal transfers, no hidden rows, cash and\ncredit accounts, one currency), so these equal Home's Spent and Income for the same window.",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "money_in": {
            "title": "Money In",
            "type": "string"
          },
          "money_out": {
            "title": "Money Out",
            "type": "string"
          },
          "result_id": {
            "title": "Result Id",
            "type": "string"
          },
          "transfers_excluded": {
            "title": "Transfers Excluded",
            "type": "integer"
          }
        },
        "required": [
          "count",
          "money_out",
          "money_in",
          "transfers_excluded",
          "currency",
          "result_id"
        ],
        "title": "TransactionTotals",
        "type": "object"
      },
      "TransferInfo": {
        "properties": {
          "confidence": {
            "enum": [
              "high",
              "low"
            ],
            "title": "Confidence",
            "type": "string"
          },
          "group_id": {
            "title": "Group Id",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "internal",
              "card_payment"
            ],
            "title": "Kind",
            "type": "string"
          },
          "other_leg": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OtherLeg"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "group_id",
          "kind",
          "confidence",
          "other_leg"
        ],
        "title": "TransferInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Finance Agent charts",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts": {
      "get": {
        "operationId": "accounts_api_accounts_get",
        "parameters": [
          {
            "in": "query",
            "name": "currency",
            "required": false,
            "schema": {
              "default": "USD",
              "title": "Currency",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Accounts"
      }
    },
    "/api/accounts/{account_id}/summary": {
      "get": {
        "operationId": "account_summary_api_accounts__account_id__summary_get",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "preset",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PeriodPreset",
              "default": "last_3_months"
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPeriodSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Account Summary"
      }
    },
    "/api/transactions": {
      "get": {
        "operationId": "transactions_api_transactions_get",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          },
          {
            "in": "query",
            "name": "account_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Account Id"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "min_amount",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Amount"
            }
          },
          {
            "in": "query",
            "name": "max_amount",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Amount"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "enum": [
                      "needs_review",
                      "pending",
                      "transfer",
                      "hidden"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "include_transfers",
            "required": false,
            "schema": {
              "default": true,
              "title": "Include Transfers",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "date_desc",
              "enum": [
                "date_desc",
                "date_asc",
                "amount_desc",
                "amount_asc"
              ],
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "currency",
            "required": false,
            "schema": {
              "default": "USD",
              "title": "Currency",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Transactions"
      }
    },
    "/api/transactions/{txn_id}": {
      "get": {
        "operationId": "transaction_api_transactions__txn_id__get",
        "parameters": [
          {
            "in": "path",
