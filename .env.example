# Copy to .env (gitignored). Model settings for the gateway; see src/finance_agent/model_gateway/config.py.

# Ollama runs natively on the host (no Metal in containers). From compose use
# http://host.docker.internal:11434
MODEL_ENDPOINT=http://localhost:11434
MODEL_NAME=qwen3:8b
MODEL_TIMEOUT_SECONDS=60

# Opt in to ONE LAN model server by pinning it here. It must equal MODEL_ENDPOINT's host:port
# and receives raw line items, so leave this unset unless you mean it.
# LOCAL_MODEL_HOSTS=192.168.1.20:11434

# Optional remote model, aggregates only. No job uses it unless listed in REMOTE_MODEL_JOBS
# (only the aggregate-only "narration" job is allowed).
# REMOTE_MODEL_ENDPOINT=
# REMOTE_MODEL_NAME=
# REMOTE_MODEL_JOBS=
